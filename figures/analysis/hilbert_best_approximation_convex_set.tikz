% Source: Roman, Advanced Linear Algebra, Chapter 13, Figure 13.1, redrawn.
\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  convex/.style={draw=blue!65!black, fill=blue!6, line width=0.75pt},
  point/.style={circle, fill=black, inner sep=1.25pt},
  seqpoint/.style={circle, fill=black, inner sep=1.05pt},
  dist/.style={line width=0.65pt, black},
  converge/.style={->, densely dotted, line width=0.75pt, black},
  labelbox/.style={fill=white, inner sep=1.1pt}
]
  \path[use as bounding box] (-0.2,0) rectangle (5.8,2.8);

  \coordinate (x) at (5.15,1.42);
  \coordinate (p) at (3.78,1.34);
  \coordinate (s1) at (1.55,0.72);
  \coordinate (s2) at (2.30,1.70);
  \coordinate (s3) at (3.00,1.18);

  \draw[convex]
    (0.35,0.42)
    .. controls (0.48,1.95) and (1.40,2.55) .. (2.75,2.38)
    .. controls (4.15,2.20) and (4.72,1.58) .. (4.25,0.92)
    .. controls (3.72,0.18) and (1.35,0.10) .. (0.35,0.42)
    -- cycle;
  \node[text=blue!65!black] at (0.88,0.67) {$C$};

  \draw[converge]
    (s1) .. controls (1.72,1.25) and (2.02,1.72) .. (s2)
         .. controls (2.55,1.60) and (2.82,1.28) .. (s3)
         .. controls (3.32,1.25) and (3.55,1.32) .. (p);
  \node[labelbox] at (2.64,0.74) {$s_n\to p$};

  \node[seqpoint,label=below:{$s_1$}] at (s1) {};
  \node[seqpoint,label=above:{$s_2$}] at (s2) {};
  \node[seqpoint,label=below left:{$s_3$}] at (s3) {};
  \node[point,label=below:{$p$}] at (p) {};
  \node[point,label=right:{$x$}] at (x) {};

  \draw[dist] (p) -- node[above, labelbox] {$d$} (x);
\end{tikzpicture}
