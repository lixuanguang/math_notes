      (1.28,1.02)
      (1.27,1.58)
      (1.62,2.02)
      (2.25,2.08)
      (2.78,1.74)
      (2.72,1.10)
      (2.05,0.82)
    };
  \node[blue!60!black] at (2.02,1.47) {$A$};

  \draw[targetset]
    plot[smooth cycle, tension=0.75] coordinates {
      (6.38,0.72)
      (6.16,1.50)
      (6.55,2.45)
      (7.55,2.88)
      (8.72,2.55)
