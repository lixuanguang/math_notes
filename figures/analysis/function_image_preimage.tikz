  \node[point] (x1) at (1.70,1.30) {};
  \node[point] (x2) at (2.34,1.83) {};
  \node[point] (x3) at (3.04,1.95) {};
  \node[point] (x4) at (0.72,0.34) {};

  \node[point] (y1) at (7.23,1.12) {};
