  \draw[maparrow] (x1) .. controls (3.25,1.08) and (5.70,1.02) .. (y1);
  \draw[maparrow] (x2) .. controls (3.75,1.68) and (5.88,1.64) .. (y2);
  \draw[maparrow] (x3) .. controls (4.12,2.42) and (6.60,2.46) .. (y3);
