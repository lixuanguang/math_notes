% Source: attached Chapter 7, Diagrams 7.1--7.3; simplified redraw.
% Solid arrows are implications. Dashed arrows mean a subsequence converges in
% the indicated mode.
\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\scriptsize},
  mode/.style={draw=blue!60!black, fill=blue!5, rounded corners=1.5pt,
    text=black,
    minimum width=0.62cm, minimum height=0.32cm, inner xsep=2pt, inner ysep=1pt},
  title/.style={font=\scriptsize\itshape, black!75, align=center, text width=2.25cm},
  imp/.style={->, black!60, line width=0.55pt},
  eqimp/.style={<->, black!60, line width=0.55pt},
  sub/.style={->, red!70!black, dashed, line width=0.55pt}
]
  \begin{scope}[xshift=0cm]
    \node[title] at (0,0.88) {general};
    \node[mode] (gAE) at (-0.86,0.32) {$AE$};
    \node[mode] (gAU) at (0.86,0.32) {$AU$};
    \node[mode] (gLP) at (-0.86,-0.32) {$L^p$};
    \node[mode] (gM) at (0.86,-0.32) {$M$};

    \draw[imp] (gAU) -- (gAE);
    \draw[imp] (gAU.south) -- (gM.north);
    \draw[imp] (gLP) -- (gM);
    \draw[sub] (gM.east) to[out=55,in=-55] (gAU.east);
  \end{scope}

  \begin{scope}[xshift=3.00cm]
    \node[title] at (0,0.88) {finite measure};
    \node[mode] (fAE) at (-0.86,0.32) {$AE$};
    \node[mode] (fAU) at (0.86,0.32) {$AU$};
    \node[mode] (fLP) at (-0.86,-0.32) {$L^p$};
    \node[mode] (fM) at (0.86,-0.32) {$M$};

    \draw[eqimp] (fAE) -- (fAU);
    \draw[imp] (fAU.south) -- (fM.north);
    \draw[imp] (fLP) -- (fM);
    \draw[sub] (fM.east) to[out=55,in=-55] (fAU.east);
  \end{scope}

  \begin{scope}[xshift=6.00cm]
    \node[title] at (0,0.88) {$L^p$ dominated};
    \node[mode] (dAE) at (-0.86,0.32) {$AE$};
    \node[mode] (dAU) at (0.86,0.32) {$AU$};
    \node[mode] (dLP) at (-0.86,-0.32) {$L^p$};
    \node[mode] (dM) at (0.86,-0.32) {$M$};

    \draw[imp] (dAU) -- (dAE);
    \draw[imp] (dAE) -- (dLP);
    \draw[eqimp] (dLP) -- (dM);
    \draw[sub] (dM.east) to[out=55,in=-55] (dAU.east);
  \end{scope}
\end{tikzpicture}
