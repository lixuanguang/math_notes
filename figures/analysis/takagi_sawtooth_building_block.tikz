\begin{tikzpicture}[
  scale=0.82,
  >=Stealth,
  every node/.style={font=\scriptsize},
  axis/.style={->, gray!70, line width=0.45pt},
  wave/.style={blue!70!black, line width=0.8pt},
  point/.style={circle, fill=gray!85, inner sep=1.2pt}
]
  \draw[axis] (-2.35,0) -- (3.35,0) node[right] {$x$};
  \draw[axis] (0,-0.15) -- (0,1.55) node[above] {$y$};

  \draw[wave]
    (-2,0) -- (-1,1) -- (0,0) -- (1,1) -- (2,0) -- (3,1);

  \foreach \x/\lab in {-2/{-2},-1/{-1},0/{0},1/{1},2/{2},3/{3}} {
    \draw[gray!70] (\x,0.045) -- (\x,-0.045);
    \node[below] at (\x,-0.04) {$\lab$};
  }
  \draw[gray!70] (0.045,1) -- (-0.045,1);
  \node[left] at (-0.04,1) {$1$};

  \foreach \p in {(-2,0),(-1,1),(0,0),(1,1),(2,0),(3,1)} {
    \node[point] at \p {};
  }
\end{tikzpicture}
