\begin{tikzpicture}[
  every node/.style={font=\scriptsize},
  box/.style={draw=black!50, line width=0.6pt, align=center, text width=2.55cm, minimum height=0.82cm, inner sep=3pt, fill=white},
  functional/.style={box, fill=blue!8},
  topological/.style={box, fill=teal!9},
  outer/.style={box, fill=orange!12},
  measure/.style={box, fill=green!10},
  arrow/.style={-{Latex[length=2mm]}, line width=0.55pt, black!65},
  extension/.style={-{Latex[length=2mm]}, line width=0.7pt, orange!75!black}
]
  \node[functional] (I) at (0,0) {positive functional\\$I:C_c(X)\to\R$};
  \node[topological] (mu) at (4.00,0) {open-set masses\\$\mu(O)=\sup I(f)$};
  \node[outer] (mustar) at (8.00,0) {outer measure\\$\mu^\ast$ from open covers};
  \node[measure] (muhat) at (12.00,0) {Radon measure $\widehat{\mu}$\\$\widehat{\mu}=\mu^\ast|_{\mathcal{B}(X)}$\\$I(f)=\int_X f\,d\widehat{\mu}$};

  \draw[arrow] (I) -- (mu);
  \draw[arrow] (mu) -- (mustar);
  \draw[extension] (mustar) -- (muhat);
\end{tikzpicture}
