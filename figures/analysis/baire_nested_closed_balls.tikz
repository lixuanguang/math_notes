\begin{tikzpicture}[
  every node/.style={font=\scriptsize},
  ambient/.style={draw=black!45, fill=gray!6, line width=0.6pt},
  ball/.style={draw=blue!70!black, line width=0.75pt},
  center/.style={circle, fill=black, inner sep=1.15pt},
  limit/.style={circle, fill=orange!80!black, inner sep=1.35pt}
]
  \coordinate (p1) at (-0.52,0);
  \coordinate (p2) at (0.08,0);
  \coordinate (p3) at (0.38,0);
  \coordinate (p) at (0.68,0);

  \draw[ambient] (0,0) circle (1.82);
  \draw[ball, fill=blue!5] (p1) circle (1.20);
  \draw[ball, fill=blue!10] (p2) circle (0.60);
  \draw[ball, fill=blue!16] (p3) circle (0.30);

  \node[center] at (p1) {};
  \node[center] at (p2) {};
  \node[center] at (p3) {};
  \node[limit] at (p) {};

  \node[right=3pt] at (p) {$p$};

  \node[black!55] at (1.26,1.18) {$U$};
  \node[blue!70!black] at (-1.45,0.94) {$C_1$};
  \node[blue!70!black] at (0.08,0.76) {$C_2$};
  \node[blue!70!black] at (0.44,0.42) {$C_3$};
\end{tikzpicture}
