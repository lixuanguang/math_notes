\begin{tikzpicture}[
  scale=0.84,
  every node/.style={font=\small},
  line cap=round,
  line join=round,
  ambient/.style={draw=black!50, fill=gray!6, rounded corners=3pt, line width=0.6pt},
  outer/.style={draw=orange!80!black, fill=orange!13, line width=0.9pt},
  closure/.style={draw=teal!70!black, fill=teal!8, dashed, line width=0.85pt},
  inner/.style={draw=teal!75!black, fill=teal!17, line width=0.85pt},
  closedset/.style={draw=black!65, fill=black!12, line width=0.75pt}
]
\draw[ambient] (-3.05,-1.45) rectangle (3.05,1.55);
\node[anchor=north west] at (-2.92,1.42) {$X$};

\draw[outer] plot[smooth cycle,tension=0.82] coordinates {
