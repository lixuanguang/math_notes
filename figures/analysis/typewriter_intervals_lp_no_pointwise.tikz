% Source: attached Chapter 7, Example 7.4; clean redraw of the interval
% enumeration behind the typewriter sequence.
\begin{tikzpicture}[
  x=6.4cm,
  y=0.46cm,
  >=Stealth,
  every node/.style={font=\scriptsize},
  base/.style={black!38, line width=0.45pt},
  tick/.style={black!28, line width=0.35pt},
  active/.style={fill=blue!18, draw=blue!70!black, line width=0.65pt},
  hit/.style={red!70!black, dashed, line width=0.55pt}
]
  \def\xhit{0.63}
  \foreach \m/\y in {1/4,2/3,3/2,4/1,5/0} {
    \draw[base] (0,\y) -- (1,\y);
    \node[left=6pt] at (0,\y) {$m=\m$};
    \pgfmathtruncatemacro{\hitj}{floor(\m*\xhit)+1}
    \foreach \j in {1,...,\m} {
      \pgfmathsetmacro{\a}{(\j-1)/\m}
      \pgfmathsetmacro{\b}{\j/\m}
      \ifnum\j=\hitj
        \filldraw[active] (\a,\y-0.12) rectangle (\b,\y+0.12);
      \fi
      \draw[tick] (\a,\y-0.15) -- (\a,\y+0.15);
    }
    \draw[tick] (1,\y-0.15) -- (1,\y+0.15);
  }

  \draw[hit] (\xhit,-0.30) -- (\xhit,4.28);
  \node[red!70!black, above] at (\xhit,4.28) {$x$};
  \node[below=2pt] at (0,-0.30) {$0$};
  \node[below=2pt] at (1,-0.30) {$1$};
\end{tikzpicture}
