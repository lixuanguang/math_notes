\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  stepbox/.style={rounded corners=2pt, align=center, text width=2.55cm, minimum height=0.82cm, inner xsep=5pt, inner ysep=3pt},
  box/.style={stepbox, draw=gray!60, fill=gray!7},
  classbox/.style={stepbox, draw=blue!65!black, fill=blue!7},
  realbox/.style={stepbox, text width=2.85cm, draw=orange!75!black, fill=orange!10},
  arrow/.style={->, line width=0.55pt, gray!70},
  include/.style={->, dashed, line width=0.48pt},
  note/.style={font=\scriptsize, align=center, text=gray!45!black}
]
  \node[box] (seq) at (0,0) {Cauchy sequence\\$(a_n)$ in $\Q$};
  \node[classbox] (eq) at (3.35,0) {same real when\\$|a_n-b_n|\to0$};
  \node[realbox] (real) at (6.7,0) {real number\\$[(a_n)]=\operatorname{LIM}a_n$};

  \draw[arrow] (seq) -- (eq);
  \draw[arrow] (eq) -- (real);

  \node[box] (const) at (0,-1.35) {rational $q$\\as $(q,q,\ldots)$};
  \node[classbox] (constclass) at (3.35,-1.35) {constant class\\$[(q,q,\ldots)]$};
  \node[realbox] (embed) at (6.7,-1.35) {embedded rational\\$q=\operatorname{LIM}q$};

  \draw[arrow] (const) -- (constclass);
  \draw[arrow] (constclass) -- (embed);
  \draw[include, blue!65!black] (const.north) -- (seq.south);
  \draw[include, blue!65!black] (constclass.north) -- (eq.south);
  \draw[include, orange!75!black] (embed.north) -- (real.south);
\end{tikzpicture}
