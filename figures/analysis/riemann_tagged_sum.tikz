\begin{tikzpicture}[
  scale=0.82,
  >=Stealth,
  every node/.style={font=\scriptsize},
  axis/.style={->, gray!70, line width=0.45pt},
  curve/.style={green!45!black, line width=0.8pt},
  rect/.style={draw=black, line width=0.55pt},
  tag/.style={circle, fill=black, inner sep=1.25pt},
  guide/.style={black!65, dashed, dash pattern=on 3pt off 2pt, line width=0.45pt}
]
  \draw[axis] (-0.45,0) -- (7.65,0) node[right] {$x$};
  \draw[axis] (0,-0.65) -- (0,4.25) node[above] {$y$};

  \coordinate (COneTop) at (1.55,2.82);
  \coordinate (CTwoTop) at (2.80,3.42);
  \coordinate (CThreeTop) at (4.05,2.55);
  \coordinate (CnTop) at (6.62,1.45);

  \draw[curve]
    (1.05,2.32) .. controls (1.18,2.60) and (1.35,2.76) .. (COneTop)
    .. controls (1.95,3.38) and (2.38,3.60) .. (CTwoTop)
    .. controls (3.25,3.58) and (3.62,3.08) .. (CThreeTop)
    .. controls (4.55,1.92) and (5.25,1.12) .. (5.82,1.25)
    .. controls (6.15,1.32) and (6.35,1.46) .. (CnTop)
    .. controls (6.84,1.50) and (7.02,1.40) .. (7.22,1.32);

  \foreach \xl/\xr/\c/\h in {
    1.05/2.05/1.55/2.82,
    2.05/3.55/2.80/3.42,
    3.55/4.55/4.05/2.55,
    6.20/7.04/6.62/1.45
  } {
    \draw[rect] (\xl,0) rectangle (\xr,\h);
    \draw[guide] (\c,0) -- (\c,\h);
    \node[tag] at (\c,0) {};
  }

  \node[below] at (1.55,-0.04) {$c_1$};
  \node[below] at (2.80,-0.04) {$c_2$};
  \node[below] at (4.05,-0.04) {$c_3$};
  \node[below] at (6.62,-0.04) {$c_n$};

  \node[anchor=base] at (1.05,-0.78) {$x_0=a$};
  \node[anchor=base] at (2.05,-0.78) {$x_1$};
  \node[anchor=base] at (3.55,-0.78) {$x_2$};
  \node[anchor=base] at (4.55,-0.78) {$x_3$};
  \node[anchor=base] at (4.98,-0.78) {$\cdots$};
  \node[anchor=base] at (6.02,-0.78) {$x_{n-1}$};
  \node[anchor=base] at (7.05,-0.78) {$x_n=b$};
\end{tikzpicture}
