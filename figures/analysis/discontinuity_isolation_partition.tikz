\begin{tikzpicture}[
  x=0.83cm,
  y=0.46cm,
  >=Stealth,
  every node/.style={font=\scriptsize},
  axis/.style={->, gray!70, line width=0.45pt},
  curve/.style={green!45!black, line width=0.85pt},
  guide/.style={gray!45, dashed, dash pattern=on 2.5pt off 2pt, line width=0.4pt},
  marker/.style={circle, fill=black, inner sep=1.25pt},
  openmarker/.style={circle, draw=black, fill=white, line width=0.45pt, inner sep=1.25pt},
  interval/.style={black!75, line width=0.55pt},
  shortinterval/.style={orange!80!black, line width=0.65pt},
  tick/.style={black, line width=0.45pt}
]
  \draw[axis] (-0.35,0) -- (7.5,0) node[right] {$x$};
  \draw[axis] (0,-0.92) -- (0,2.55) node[above] {$y$};

  \coordinate (A) at (0.65,0);
  \coordinate (U) at (2.65,0);
  \coordinate (C) at (3.25,0);
  \coordinate (V) at (3.85,0);
  \coordinate (B) at (6.9,0);

  \draw[guide] (U) -- ++(0,2.25);
  \draw[guide] (C) -- ++(0,2.25);
  \draw[guide] (V) -- ++(0,2.25);

  \draw[curve]
    (0.65,1.08) .. controls (1.08,1.30) and (1.60,1.30) .. (2.05,1.12)
    .. controls (2.34,1.00) and (2.52,1.02) .. (2.60,1.10);
  \draw[curve]
    (3.90,1.78) .. controls (4.22,1.62) and (4.48,1.12) .. (4.82,0.88)
    .. controls (5.28,0.58) and (5.92,0.72) .. (6.35,0.94)
    .. controls (6.58,1.08) and (6.75,1.02) .. (6.95,0.88);

  \node[openmarker] at (3.25,1.12) {};
  \node[marker] at (3.25,1.88) {};

  \foreach \x in {0.65,2.65,3.25,3.85,6.9} {
    \draw[tick] (\x,0.08) -- (\x,-0.08);
  }
  \node[above=2pt] at (0.65,0) {$a$};
  \node[below=2pt] at (2.65,0) {$u$};
  \node[above=2pt] at (3.25,0) {$c$};
  \node[below=2pt] at (3.85,0) {$v$};
  \node[above=2pt] at (6.9,0) {$b$};

  \draw[interval] (0.65,-0.78) -- (2.65,-0.78);
  \draw[interval] (2.65,-0.71) -- (2.65,-0.85);
  \draw[interval] (0.65,-0.71) -- (0.65,-0.85);
  \node[below] at (1.65,-0.81) {$K$};

  \draw[shortinterval] (2.65,-0.78) -- (3.85,-0.78);
  \draw[shortinterval] (3.85,-0.71) -- (3.85,-0.85);
  \draw[shortinterval] (2.65,-0.71) -- (2.65,-0.85);
  \node[orange!80!black, below] at (3.25,-0.81) {$I$};

  \draw[interval] (3.85,-0.78) -- (6.9,-0.78);
  \draw[interval] (6.9,-0.71) -- (6.9,-0.85);
  \draw[interval] (3.85,-0.71) -- (3.85,-0.85);
  \node[below] at (5.38,-0.81) {$K$};
\end{tikzpicture}
