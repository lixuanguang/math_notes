\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\scriptsize},
  sourcebox/.style={draw=blue!55!black, fill=blue!5, rounded corners=1.5pt,
    minimum width=1.95cm, minimum height=0.66cm, align=center,
    inner xsep=5pt, inner ysep=4pt},
  stepbox/.style={draw=violet!55!black, fill=violet!6, rounded corners=1.5pt,
    minimum width=2.10cm, minimum height=0.66cm, align=center,
    inner xsep=5pt, inner ysep=4pt},
  densebox/.style={draw=green!45!black, fill=green!8, rounded corners=1.5pt,
    minimum width=2.25cm, minimum height=0.66cm, align=center,
    inner xsep=5pt, inner ysep=4pt},
  warnbox/.style={draw=red!55!black, fill=red!5, rounded corners=1.5pt,
    minimum width=2.25cm, minimum height=0.66cm, align=center,
    inner xsep=5pt, inner ysep=4pt},
  arrow/.style={->, line width=0.55pt, black!65, shorten <=2pt, shorten >=2pt},
  rowword/.style={font=\tiny\itshape, text=black!68, anchor=east}
]
  \node[rowword] at (-6.45,0.72) {$1\leq p<\infty$};
  \node[sourcebox] (lp) at (-5.15,0.72) {$L^p(E)$};
  \node[stepbox] (finite) at (-2.575,0.72) {finite-measure\\support};
  \node[stepbox] (simple) at (0.075,0.72) {simple\\functions};
  \node[stepbox, minimum width=2.35cm] (rstep) at (2.85,0.72)
    {rational\\interval steps};
  \node[densebox] (countable) at (5.70,0.72) {countable\\dense set};

  \node[stepbox, minimum width=2.35cm] (cutoffs) at (2.85,-0.50)
    {$C_c(E)$\\cutoffs};
  \node[densebox] (ccdense) at (5.70,-0.50) {$C_c(E)$\\dense};

  \node[rowword] at (-6.45,-1.85) {$p=\infty$};
  \node[warnbox] (linfty) at (-2.575,-1.85) {$L^\infty([a,b])$};
  \node[warnbox] (indicators) at (0.225,-1.85) {separated\\indicators};
  \node[warnbox] (notsep) at (3.025,-1.85) {not\\separable};

  \draw[arrow] (lp) -- (finite);
  \draw[arrow] (finite) -- (simple);
  \draw[arrow] (simple) -- (rstep);
  \draw[arrow] (rstep) -- (countable);
  \draw[arrow] (rstep) -- (cutoffs);
  \draw[arrow] (cutoffs) -- (ccdense);

  \draw[arrow] (linfty) -- (indicators);
  \draw[arrow] (indicators) -- (notsep);
\end{tikzpicture}
