\begin{tikzpicture}[
  x=1cm,
  y=1cm,
  >=Stealth,
  line cap=round,
  line join=round,
  every node/.style={font=\scriptsize},
  box/.style={draw=black!70, rounded corners=2pt, align=center,
    minimum width=1.9cm, minimum height=0.66cm, inner xsep=5pt, inner ysep=3pt},
  diff/.style={draw=blue!70!black, text=blue!70!black, rounded corners=2pt,
    align=center, minimum width=2.05cm, minimum height=0.66cm,
    inner xsep=5pt, inner ysep=3pt},
  formula/.style={align=left, text=black!78},
  gain/.style={align=left, text=blue!70!black},
  label/.style={align=right, text=black!70},
  arrow/.style={->, black!72, line width=0.65pt, shorten <=1pt, shorten >=2pt},
  guide/.style={gray!45, dashed, line width=0.45pt}
]
  \node[label, anchor=east] (unpaired) at (-3.3,0.78) {unpaired};
  \node[box] (sep) at (-2.15,0.78) {separate units};
  \node[box] (mean) at (0.65,0.78) {$\overline X-\overline Y$};
  \node[formula, anchor=west] (uvar) at (2.55,0.78)
    {$\operatorname{Var}(\overline X-\overline Y)=2\sigma^2/n$};

  \node[label, text=blue!70!black, anchor=east] (paired) at (-3.3,-0.78) {paired};
  \node[box] (same) at (-2.15,-0.78) {same unit $i$};
  \node[diff] (contrast) at (0.65,-0.78) {$D_i=X_i-Y_i$};
  \node[gain, anchor=west] (pvar) at (2.55,-0.78)
    {$\operatorname{Var}(\overline D)=2\sigma^2(1-\rho)/n$};

  \draw[arrow] (sep) -- (mean);
  \draw[arrow] (mean) -- (uvar);
  \draw[arrow] (same) -- (contrast);
  \draw[arrow] (contrast) -- (pvar);
  \draw[guide] (-3.85,0) -- (6.35,0);
\end{tikzpicture}
