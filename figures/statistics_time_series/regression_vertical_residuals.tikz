% Schematic redraw for ordinary least-squares vertical residuals.
\begin{tikzpicture}[
  x=0.82cm,
  y=0.66cm,
  >=Stealth,
  line cap=round,
  line join=round,
  every node/.style={font=\scriptsize},
  axis/.style={->, gray!70, line width=0.45pt},
  fit/.style={blue!70!black, line width=0.95pt},
  residual/.style={red!70!black, densely dashed, line width=0.5pt},
  point/.style={circle, fill=black, inner sep=0pt, minimum size=2.1pt},
  fittedpoint/.style={circle, fill=blue!70!black, inner sep=0pt, minimum size=1.8pt}
]
  \path[use as bounding box] (-0.15,-0.2) rectangle (4.75,3.15);

  \draw[axis] (-0.08,0) -- (4.55,0) node[black!78,right] {$x$};
  \draw[axis] (0,-0.08) -- (0,3.05) node[black!78,above] {$y$};

  \draw[fit] (0.4,0.7) -- (4.15,2.77);

  \foreach \x/\y/\yh in {
    0.75/1.17/0.89,
    1.25/0.82/1.17,
    1.85/1.80/1.50,
    2.45/1.58/1.83,
    3.05/2.62/2.16,
    3.65/2.36/2.49
  }{
    \draw[residual] (\x,\yh) -- (\x,\y);
    \node[fittedpoint] at (\x,\yh) {};
    \node[point] at (\x,\y) {};
  }

  \draw[red!70!black, line width=0.7pt] (3.05,2.16) -- (3.05,2.62);
\end{tikzpicture}
