\begin{tikzpicture}[
  x=0.72cm,
  y=0.72cm,
  >=Stealth,
  line cap=round,
  line join=round,
  every node/.style={font=\scriptsize},
  axis/.style={->, gray!70, line width=0.45pt},
  point/.style={circle, fill=black, inner sep=1.0pt},
  nearpoint/.style={circle, draw=green!45!black, fill=green!10, line width=0.55pt, inner sep=1.15pt},
  target/.style={circle, fill=red!75!black, inner sep=1.45pt},
  fixed/.style={blue!70!black, line width=0.95pt},
  adaptive/.style={green!45!black, line width=0.95pt},
  guide/.style={gray!55, dashed, line width=0.45pt},
  labelbox/.style={fill=white, inner xsep=2pt, inner ysep=1pt}
]
  \path[use as bounding box] (-0.35,-0.52) rectangle (8.55,1.88);
  \draw[axis] (0,0) -- (8.15,0) node[black!75,right] {$x$};

  \foreach \x in {0.55,1.20,2.05,2.85,3.38,5.65,6.40,7.18,7.78}
    \node[point] at (\x,0) {};
  \foreach \x in {3.85,4.20,4.62,4.92,5.12}
    \node[nearpoint] at (\x,0) {};

  \coordinate (xzero) at (4.45,0);
  \node[target] at (xzero) {};
  \node[below=2pt, text=black!80] at (xzero) {$x_0$};

  \draw[guide] (xzero) -- (4.45,1.52);

  \draw[fixed] (2.85,0.62) -- (6.05,0.62);
  \draw[fixed] (2.85,0.50) -- (2.85,0.74);
  \draw[fixed] (6.05,0.50) -- (6.05,0.74);
  \node[blue!70!black, labelbox, above=4pt] at (4.45,0.62) {fixed metric window};

  \draw[adaptive] (3.78,1.24) -- (5.12,1.24);
  \draw[adaptive] (3.78,1.12) -- (3.78,1.36);
  \draw[adaptive] (5.12,1.12) -- (5.12,1.36);
  \node[green!45!black, labelbox, above=4pt] at (4.45,1.24) {$k$-nearest window};
\end{tikzpicture}
