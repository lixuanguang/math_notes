\begin{tikzpicture}[>=Stealth,node distance=1.1cm,every node/.style={font=\small}]
  \node (x1) {$X_1$};
  \node[right=of x1] (x2) {$X_2$};
  \node[right=of x2] (x3) {$X_3$};
  \node[right=of x3] (dots) {$\cdots$};
  \node[right=of dots] (xn) {$X_n$};
  \node[right=of xn] (dots2) {$\cdots$};
  \draw[->,thick] (x1) -- (x2);
  \draw[->,thick] (x2) -- (x3);
  \draw[->,thick] (x3) -- (dots);
  \draw[->,thick] (dots) -- (xn);
  \draw[->,thick] (xn) -- (dots2);
\end{tikzpicture}
