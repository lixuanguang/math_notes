\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  mat/.style={draw=gray!55, fill=gray!5, rounded corners=2pt, inner xsep=5.5pt, inner ysep=4.5pt, align=center},
  phasebox/.style={draw=blue!60!black, fill=blue!7, rounded corners=2pt, inner xsep=4.5pt, inner ysep=3.5pt, align=center},
  arr/.style={->, line width=0.75pt, blue!70!black}
]
  \node[mat] (T) at (0,0)
    {$T=\left(\begin{smallmatrix}
      \lambda_1&*&*\\
      0&\lambda_2&*\\
      0&0&\lambda_3
    \end{smallmatrix}\right)$};
  \node[phasebox] (p1) at (3.26,0.70) {$Q_1=T-\lambda_1I_n$\\first column $0$};
  \node[phasebox] (p2) at (3.26,-0.70) {$Q_2=Q_1(T-\lambda_2I_n)$\\first two columns $0$};
  \node[mat] (pn) at (6.78,0) {$Q_n=\prod\limits_{i=1}^{n}(T-\lambda_iI_n)=0$};

  \draw[arr] (T.east) -- (p1.west);
  \draw[arr] (p1.south) -- (p2.north);
  \draw[arr] (p2.east) -- (pn.west);
\end{tikzpicture}
