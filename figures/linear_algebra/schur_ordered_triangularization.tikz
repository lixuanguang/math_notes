\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  block/.style={draw=gray!55, fill=gray!5, rounded corners=2pt, inner xsep=5pt, inner ysep=4pt, align=center, minimum height=0.86cm},
  focus/.style={draw=blue!65!black, fill=blue!7, rounded corners=2pt, inner xsep=5pt, inner ysep=4pt, align=center, minimum height=0.86cm},
  arr/.style={->, line width=0.75pt, blue!70!black}
]
  \node[focus] (line) at (0,0)
    {$A\mathbf{x}=\lambda_1\mathbf{x}$};
  \node[block] (block) at (2.90,0)
    {$V^*AV=\left(\begin{smallmatrix}\lambda_1&*\\0&A'\end{smallmatrix}\right)$};
  \node[block] (tri) at (6.05,0)
    {$U^*AU=T$};

  \draw[arr] (line) -- (block);
  \draw[arr] (block) -- (tri);
\end{tikzpicture}
