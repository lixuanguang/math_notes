\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  block/.style={draw=gray!55, rounded corners=3pt, inner xsep=9pt, inner ysep=6pt, align=center},
  arrow/.style={->, line width=0.8pt, blue!70!black, shorten >=2pt, shorten <=2pt}
]
  \node[block] (family) at (0,0) {$\mathcal{F}$};
  \node[block] (split) at (2.8,0) {$A_0=\sum_j\mu_jP_j$};
  \node[block] (pieces) at (6.05,0) {$\bigoplus_j\operatorname{range}(P_j)$};
  \node[block] (basis) at (9.65,0) {common eigenbasis};

  \draw[arrow] (family.east) -- (split.west);
  \draw[arrow] (split.east) -- (pieces.west);
  \draw[arrow] (pieces.east) -- (basis.west);
\end{tikzpicture}
