\begin{tikzpicture}[
  >=Stealth,
  x=0.88cm,
  every node/.style={font=\small},
  space/.style={draw=gray!70, fill=gray!8, rounded corners=3pt, minimum width=1.62cm, minimum height=0.64cm, align=center},
  map/.style={->, line width=1pt, blue!70!black}
]
  \node[space] (kerA) at (0,0) {$\ker(A)$};
  \node[space] (row) at (2.45,0) {$\operatorname{col}(A^*)$};
  \node[space] (col) at (5.55,0) {$\operatorname{col}(A)$};
  \node[space] (kerAst) at (8.0,0) {$\ker(A^*)$};
  \node[red!70!black] at (0,-0.58) {$A=0$};
  \node[red!70!black] at (8.0,-0.58) {$A^{\dagger}=0$};

  \draw[map] ([yshift=2.4pt]row.east) -- node[midway, above=1pt] {$A$} ([yshift=2.4pt]col.west);
  \draw[map] ([yshift=-2.4pt]col.west) -- node[midway, below=1pt] {$A^{\dagger}$} ([yshift=-2.4pt]row.east);
\end{tikzpicture}
