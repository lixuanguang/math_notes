\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  box/.style={draw=gray!55, fill=gray!5, rounded corners=2pt, align=center, inner sep=6pt, minimum width=1.8cm},
  main/.style={draw=blue!60!black, fill=blue!7, rounded corners=2pt, align=center, inner sep=6pt, minimum width=1.8cm},
  arr/.style={->, line width=0.75pt, blue!70!black}
]
  \node[main] (mu) at (0,0) {$\mu_A$};
  \node[box] (char) at (3.0,0.65) {$p_A$};
  \node[box] (other) at (3.0,-0.65) {$f(A)=0$};

  \draw[arr] (mu) -- (char);
  \draw[arr] (mu) -- (other);
\end{tikzpicture}
