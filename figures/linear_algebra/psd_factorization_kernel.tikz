\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  box/.style={draw=gray!55, rounded corners=3pt, fill=gray!6, align=center, inner xsep=8pt, inner ysep=6pt, minimum height=0.95cm},
  result/.style={box, fill=green!7, minimum width=2.7cm},
  arrow/.style={->, line width=0.85pt, blue!70!black}
]
  \node[box, minimum width=2.3cm] (factor) at (0,0) {$A=B^*B$};
  \node[box, minimum width=4.45cm] (test) at (4.05,0)
    {$\mathbf{x}^*A\mathbf{x}=\norm{B\mathbf{x}}_2^2$\\[-1pt]
     $\norm{B\mathbf{x}}_2^2=0\Longleftrightarrow B\mathbf{x}=0$};
  \node[result] (kernel) at (8.25,0) {$\ker(A)=\ker(B)$};

  \draw[arrow] (factor) -- (test);
  \draw[arrow] (test) -- (kernel);
\end{tikzpicture}
