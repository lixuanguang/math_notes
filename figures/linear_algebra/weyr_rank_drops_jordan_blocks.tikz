\begin{tikzpicture}[
  font=\small,
  rank/.style={draw=blue!60!black, fill=blue!6, rounded corners=2pt, minimum width=1.1cm, minimum height=0.58cm, align=center},
  count/.style={draw=red!60!black, fill=red!6, rounded corners=2pt, minimum width=3.25cm, minimum height=0.58cm, align=center},
  arrow/.style={-{Stealth[length=2mm]}, thick, gray!75}
]
  \node[rank] (r0) at (0,0) {$r_0$};
  \node[rank] (r1) at (1.55,0) {$r_1$};
  \node[rank] (r2) at (3.1,0) {$r_2$};
  \node[rank] (dots) at (4.65,0) {$\cdots$};
  \node[rank] (rq) at (6.2,0) {$r_q$};

  \node[count] (drop) at (3.1,-1.0) {$w_p=r_{p-1}-r_p$};
  \node[count, minimum width=3.65cm] (exact) at (3.1,-1.85) {size-$p$ blocks $=w_p-w_{p+1}$};

  \draw[arrow] (r0) -- (r1);
  \draw[arrow] (r1) -- (r2);
  \draw[arrow] (r2) -- (dots);
  \draw[arrow] (dots) -- (rq);
  \draw[arrow] (drop) -- (exact);
\end{tikzpicture}
