\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  box/.style={draw=gray!60, fill=gray!6, rounded corners=2pt, align=center, inner sep=6pt, minimum height=0.85cm, text width=2.15cm},
  main/.style={draw=blue!60!black, fill=blue!6, rounded corners=2pt, align=center, inner sep=6pt, minimum height=0.85cm, text width=2.15cm},
  good/.style={draw=dartmouthgreen!70!black, fill=dartmouthgreen!8, rounded corners=2pt, align=center, inner sep=6pt, minimum height=0.85cm, text width=1.7cm},
  arr/.style={->, line width=0.7pt, draw=black!70}
]
  \node[box] (candidate) at (0,0)
    {monic candidate\\$p_m(z)$};
  \node[main] (system) at (3.2,0)
    {solve for\\$a_0,\ldots,a_{m-1}$};
  \node[box] (first) at (6.4,0)
    {first solvable\\degree $m$};
  \node[good] (mu) at (9.1,0)
    {$\mu_T=p_m$};

  \draw[arr] (candidate) -- (system);
  \draw[arr] (system) -- (first);
  \draw[arr] (first) -- (mu);
\end{tikzpicture}
