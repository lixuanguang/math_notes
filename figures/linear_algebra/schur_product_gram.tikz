\begin{tikzpicture}[
  >=Stealth,
  x=0.86cm,
  y=0.86cm,
  every node/.style={font=\small},
  box/.style={draw=gray!55, rounded corners=3pt, fill=gray!6, align=center, inner sep=4pt},
  arrow/.style={->, line width=0.85pt, blue!70!black}
]
  \node[box] (a) at (0,0.55) {$A$};
  \node[box] (b) at (0,-0.55) {$B$};
  \node[box] (pair) at (2.65,0) {$\mathbf{u}_j\otimes\mathbf{v}_j$};
  \node[box] (gram) at (5.35,0) {$A\circ B$};

  \draw[arrow] (a.east) -- (pair.west);
  \draw[arrow] (b.east) -- (pair.west);
  \draw[arrow] (pair) -- (gram) node[midway, above] {Gram};
\end{tikzpicture}
