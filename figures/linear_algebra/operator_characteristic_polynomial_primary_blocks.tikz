\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  block/.style={draw=blue!60!black, fill=blue!6, rounded corners=2pt, align=center, inner sep=5pt, minimum width=1.9cm},
  factor/.style={draw=dartmouthgreen!70!black, fill=dartmouthgreen!8, rounded corners=2pt, align=center, inner sep=5pt, minimum width=1.9cm},
  result/.style={draw=gray!60, fill=gray!6, rounded corners=2pt, align=center, inner sep=6pt},
  arr/.style={->, line width=0.7pt, draw=black!70}
]
  \node[block] (G1) at (-2.9,0) {$G(\lambda_1,T)$};
  \node (Gdots) at (0,0) {$\cdots$};
  \node[block] (Gm) at (2.9,0) {$G(\lambda_m,T)$};

  \node[factor] (F1) at (-2.9,-1.25) {$(z-\lambda_1)^{d_1}$};
  \node (Fdots) at (0,-1.25) {$\cdots$};
  \node[factor] (Fm) at (2.9,-1.25) {$(z-\lambda_m)^{d_m}$};

  \node[result] (q) at (0,-2.45) {$q_T(z)=\prod_{j=1}^{m}(z-\lambda_j)^{d_j}$};

  \draw[arr] (G1) -- (F1);
  \draw[arr] (Gm) -- (Fm);
  \draw[arr] (F1.south east) -- (q.north west);
  \draw[arr] (Fm.south west) -- (q.north east);
\end{tikzpicture}
