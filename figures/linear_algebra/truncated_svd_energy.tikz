\begin{tikzpicture}[
  >=Stealth,
  x=0.92cm,
  every node/.style={font=\small},
  kept/.style={draw=blue!70!black, fill=blue!10, rounded corners=2pt, minimum width=0.65cm, minimum height=2.2cm},
  tail/.style={draw=red!70!black, fill=red!10, rounded corners=2pt, minimum width=0.65cm}
]
  \node at (-0.45,1.22) {$\sigma_j$};
  \draw[->, gray!70] (0,0) -- (7.0,0);
  \draw[->, gray!70] (0,0) -- (0,2.42);

  \foreach \x/\h/\lab in {0.7/2.03/1,1.55/1.62/2,2.4/1.31/k} {
    \node[kept, minimum height=\h cm] at (\x,\h/2) {};
    \node[blue!70!black] at (\x,-0.27) {$\lab$};
  }
  \foreach \x/\h/\lab in {3.45/0.95/k+1,4.3/0.74/,5.15/0.59/,6.0/0.47/r} {
    \node[tail, minimum height=\h cm] at (\x,\h/2) {};
    \node[red!70!black] at (\x,-0.27) {$\lab$};
  }

  \draw[dashed, gray!65] (2.9,0) -- (2.9,2.22);
\end{tikzpicture}
