\begin{tikzpicture}[
  font=\small,
  node/.style={draw=blue!60!black, fill=blue!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=2.9cm},
  mid/.style={draw=red!60!black, fill=red!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=3.3cm},
  arr/.style={-{Stealth[length=2mm]}, thick, gray!75}
]
  \node[node] (conj) at (0,0) {$A\sim\overline{A}$};
  \node[node] (adj) at (4.0,0) {$A\sim A^*$};
  \node[mid] (herm) at (8.3,0) {$A=HA^*H^{-1}$\\$H=H^*$};
  \node[node] (prod) at (4.0,-1.75) {$A=HK$\\$H=H^*,\ K=K^*$};

  \draw[arr] (conj) -- node[above] {transpose} (adj);
  \draw[arr] (adj) -- node[above] {phase average} (herm);
  \draw[arr] (herm) -- node[right] {factor} (prod);
  \draw[arr] (prod) -- node[left] {$HK\sim KH$} (conj);
\end{tikzpicture}
