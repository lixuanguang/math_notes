\begin{tikzpicture}[
  >=Stealth,
  scale=0.84,
  axis/.style={->, gray!60, line width=0.6pt},
  rowdisk/.style={draw=blue!65!black, fill=blue!10, line width=0.8pt},
  coldisk/.style={draw=green!45!black, fill=green!10, line width=0.75pt, dashed},
  radius/.style={->, draw=blue!70!black, line width=0.65pt},
  eig/.style={circle, fill=red!75!black, inner sep=1.8pt},
  lab/.style={font=\small, align=center},
  tinylabel/.style={font=\scriptsize, align=center}
]
  \draw[axis] (-4.1,0) -- (5.1,0) node[right] {$\operatorname{Re}z$};
  \draw[axis] (0,-2.8) -- (0,3.05) node[above] {$\operatorname{Im}z$};

  \coordinate (r1) at (-1.7,0.75);
  \coordinate (r2) at (1.15,-0.55);
  \coordinate (r3) at (3.05,1.05);

  \draw[rowdisk] (r1) circle (1.15);
  \draw[rowdisk] (r2) circle (1.55);
  \draw[rowdisk] (r3) circle (0.95);

  \draw[coldisk] (r1) circle (0.82);
  \draw[coldisk] (r2) circle (1.12);
  \draw[coldisk] (r3) circle (0.65);

  \fill[black] (r1) circle (1.4pt) node[above left=2pt, lab] {$a_{11}$};
  \fill[black] (r2) circle (1.4pt) node[below right=2pt, lab] {$a_{22}$};
  \fill[black] (r3) circle (1.4pt) node[above right=2pt, lab] {$a_{33}$};

  \draw[radius] (r1) -- ++(1.15,0) node[midway, above, tinylabel] {$R'_1$};
  \draw[radius] (r2) -- ++(0,1.55) node[midway, right, tinylabel] {$R'_2$};
  \draw[radius] (r3) -- ++(-0.67,-0.67) node[midway, below right=-1pt, tinylabel] {$R'_3$};

  \node[eig] at (-1.25,0.35) {};
  \node[eig] at (1.35,-0.45) {};
  \node[eig] at (2.72,1.22) {};

  \node[lab] at (-2.55,2.12) {$G_1(A)$};
  \node[lab] at (0.8,1.55) {$G_2(A)$};
  \node[lab] at (3.65,1.9) {$G_3(A)$};
\end{tikzpicture}
