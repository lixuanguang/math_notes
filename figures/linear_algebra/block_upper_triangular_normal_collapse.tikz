\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  block/.style={draw=gray!55, rounded corners=3pt, inner sep=7pt, align=center},
  arrow/.style={->, line width=0.85pt, blue!70!black}
]
  \node[block] (tri) at (0,0)
    {$A=\begin{bmatrix}B&X\\0&C\end{bmatrix}$\\normal};
  \node[block] (trace) at (3.9,0)
    {$B^*B=BB^*+XX^*$\\$\operatorname{tr}(XX^*)=0$};
  \node[block] (diag) at (8.0,0)
    {$A=\begin{bmatrix}B&0\\0&C\end{bmatrix}$\\$B,C$ normal};

  \draw[arrow] (tri) -- (trace);
  \draw[arrow] (trace) -- (diag) node[midway, above=4pt] {$X=0$};
\end{tikzpicture}
