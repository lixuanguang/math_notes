\begin{tikzpicture}[
  font=\small,
  block/.style={draw=blue!60!black, fill=blue!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=2.25cm},
  poly/.style={draw=red!60!black, fill=red!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=2.65cm},
  arr/.style={-{Stealth[length=2mm]}, thick, gray!75}
]
  \node[block] (j1) at (0,0) {$J_{m_1}(\lambda_1)$};
  \node[block] (j2) at (2.9,0) {$J_{m_2}(\lambda_2)$};
  \node[block] (jd) at (5.8,0) {$\cdots$};
  \node[block] (jk) at (8.7,0) {$J_{m_d}(\lambda_d)$};

  \node[poly] (p1) at (0,-1.55) {$p_1(J_{m_1})$};
  \node[poly] (p2) at (2.9,-1.55) {$p_2(J_{m_2})$};
  \node[poly] (pd) at (5.8,-1.55) {$\cdots$};
  \node[poly] (pk) at (8.7,-1.55) {$p_d(J_{m_d})$};

  \node[poly, minimum width=4.0cm] (p) at (4.35,-3.0) {$p\equiv p_i\pmod{(z-\lambda_i)^{m_i}}$};

  \draw[arr] (j1) -- (p1);
  \draw[arr] (j2) -- (p2);
  \draw[arr] (jk) -- (pk);
  \draw[arr] (p1) -- (p);
  \draw[arr] (p2) -- (p);
  \draw[arr] (pk) -- (p);
\end{tikzpicture}
