\begin{tikzpicture}[
  font=\small,
  box/.style={draw=blue!60!black, fill=blue!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=2.6cm},
  aux/.style={draw=gray!65, fill=gray!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=2.9cm},
  good/.style={draw=red!60!black, fill=red!6, rounded corners=2pt, align=center, inner sep=6pt, minimum width=3.2cm},
  arr/.style={-{Stealth[length=2mm]}, thick, gray!75}
]
  \node[box] (ab) at (0,0) {$AB-\lambda I$};
  \node[aux] (x) at (3.7,0) {$X-\lambda I_{2n}$};
  \node[aux] (y) at (7.4,0) {$Y-\lambda I_{2n}$};
  \node[box] (ba) at (11.1,0) {$BA-\lambda I$};

  \node[good] (rank) at (5.55,-1.45) {same ranks of powers};
  \node[good] (weyr) at (5.55,-2.45) {same Weyr data at $\lambda\neq0$};

  \draw[arr] (ab) -- node[above] {embed} (x);
  \draw[arr] (x) -- node[above] {similar} (y);
  \draw[arr] (y) -- node[above] {extract} (ba);
  \draw[arr] (x) -- (rank);
  \draw[arr] (y) -- (rank);
  \draw[arr] (rank) -- (weyr);
\end{tikzpicture}
