\begin{tikzpicture}[
  >=Stealth,
  node distance=1.0cm and 1.2cm,
  box/.style={draw=blue!55!black, fill=blue!5, rounded corners=2pt, align=center, minimum height=0.9cm, minimum width=2.35cm, font=\small},
  root/.style={circle, draw=red!70!black, fill=red!10, inner sep=2pt, font=\small},
  arr/.style={->, line width=0.65pt, draw=black!70}
]
  \node[box] (matrix) {$A$};
  \node[box, right=of matrix] (poly) {$p_A$};
  \node[box, right=of poly] (roots) {roots};

  \draw[arr] (matrix) -- (poly);
  \draw[arr] (poly) -- (roots);

  \node[root, below=0.85cm of roots, xshift=-0.9cm] (l1) {$\lambda_1$};
  \node[root, below=0.85cm of roots] (l2) {$\lambda_2$};
  \node[root, below=0.85cm of roots, xshift=0.9cm] (ld) {$\lambda_d$};
  \draw[arr] (roots) -- (l1);
  \draw[arr] (roots) -- (l2);
  \draw[arr] (roots) -- (ld);
\end{tikzpicture}
