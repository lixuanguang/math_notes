\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  coord/.style={draw=gray!55, fill=gray!5, rounded corners=3pt,
    minimum width=2.55cm, minimum height=0.72cm, align=center},
  arrow/.style={->, line width=0.75pt, gray!70!black},
  hint/.style={font=\scriptsize, text=gray!70!black, align=center, inner sep=1pt}
]
  \node[coord] (gamma) at (0,0) {$\gamma$-coordinates\\$[\mathbf{x}]_{\gamma},[\mathbf{y}]_{\gamma}$};
  \node[coord] (beta) at (4.7,0) {$\beta$-coordinates\\$[\mathbf{x}]_{\beta},[\mathbf{y}]_{\beta}$};

  \draw[arrow] (gamma) -- node[above, hint] {$C_{\beta\leftarrow\gamma}$ on both slots} (beta);
  \node at (2.35,-0.95) {$M_{\gamma}=C_{\beta\leftarrow\gamma}^{\,t}M_{\beta}C_{\beta\leftarrow\gamma}$};
\end{tikzpicture}
