\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  coord/.style={draw=gray!55, fill=gray!5, rounded corners=3pt,
    minimum width=2.30cm, align=center, inner xsep=6pt, inner ysep=4pt},
  arrow/.style={->, line width=0.8pt, gray!65!black},
  hint/.style={font=\scriptsize, text=gray!70!black, align=center, inner sep=1pt}
]
  \node[coord] (gamma) at (0,0) {$\gamma$-coordinates\\$[\mathbf{x}]_{\gamma},[\mathbf{y}]_{\gamma}$};
  \node[coord] (beta) at (5.40,0) {$\beta$-coordinates\\$[\mathbf{x}]_{\beta},[\mathbf{y}]_{\beta}$};

  \draw[arrow] (gamma) -- node[midway, above, hint, fill=white, inner xsep=2pt] {$C_{\beta\leftarrow\gamma}$} (beta);
\end{tikzpicture}
