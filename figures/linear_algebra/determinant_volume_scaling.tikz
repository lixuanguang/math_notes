\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  axis/.style={->, gray!70},
  vec/.style={->, line width=1pt},
  areaA/.style={fill=blue!12, draw=blue!50},
  areaB/.style={fill=red!12, draw=red!55},
  arrow/.style={->, line width=0.85pt, blue!70!black}
]
  \begin{scope}
    \draw[axis] (-0.17,0) -- (2.06,0);
    \draw[axis] (0,-0.17) -- (0,1.72);
    \draw[areaA] (0,0) rectangle (1.16,0.90);
    \node at (0.58,0.45) {$\Omega$};
  \end{scope}

  \draw[arrow] (2.30,0.65) -- (3.48,0.65) node[midway, above=4pt] {$T$};

  \begin{scope}[shift={(3.85,0)}]
    \draw[axis] (-0.17,0) -- (2.58,0);
    \draw[axis] (0,-0.17) -- (0,1.90);
    \coordinate (O) at (0,0);
    \coordinate (a) at (1.94,0.30);
    \coordinate (b) at (0.56,1.33);
    \coordinate (ab) at ($(a)+(b)$);
    \draw[areaB] (O) -- (a) -- (ab) -- (b) -- cycle;
    \draw[vec, blue!75!black] (O) -- (a);
    \draw[vec, red!75!black] (O) -- (b);
    \node at (1.25,0.82) {$T(\Omega)$};
  \end{scope}
\end{tikzpicture}
