\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  plane/.style={draw=teal!60!black, fill=teal!8, line width=0.6pt},
  vec/.style={->, line width=0.9pt},
  residual/.style={->, line width=0.85pt, red!70!black},
  fit/.style={->, line width=0.9pt, blue!70!black},
  labelbox/.style={fill=white, inner sep=1.5pt, text opacity=1}
]
  \path[use as bounding box] (-0.7,-0.58) rectangle (7.35,3.28);

  \coordinate (O) at (0,0);
  \coordinate (A) at (-0.42,-0.18);
  \coordinate (B) at (6.35,0.42);
  \coordinate (C) at (7.05,1.88);
  \coordinate (D) at (0.78,1.46);
  \coordinate (P) at (3.82,0.82);
  \coordinate (Y) at (3.82,2.86);

  \fill[plane] (A) -- (B) -- (C) -- (D) -- cycle;
  \node[text=green!45!black] at (6.04,1.34) {$\operatorname{col}(A)$};

  \draw[vec, gray!72] (O) -- (Y) node[above=2pt, text=gray!70!black] {$\mathbf{y}$};
  \draw[fit] (O) -- (P) node[pos=0.56, below=5pt, labelbox, text=blue!70!black] {$A\mathbf{x}_0$};
  \draw[residual] (P) -- (Y)
    node[pos=0.58, right=7pt, labelbox, text=red!70!black] {$\mathbf{r}\in\ker(A^*)$};

  \draw[gray!60] ($(P)+(0.18,0)$) -- ($(P)+(0.18,0.18)$) -- ($(P)+(0,0.18)$);

  \node[circle, fill=black, inner sep=1pt, label=below left:{$\mathbf{0}$}] at (O) {};
  \node[circle, fill=black, inner sep=1pt] at (P) {};
  \node[circle, fill=black, inner sep=1pt] at (Y) {};
\end{tikzpicture}
