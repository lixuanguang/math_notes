\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  block/.style={draw=gray!55, rounded corners=3pt, inner xsep=7pt, inner ysep=4.5pt, align=center},
  arrow/.style={->, line width=0.8pt, blue!70!black}
]
  \node[block] (space) at (0,0) {$\mathcal{V}$};
  \node[block] (decomp) at (2.82,0) {$E_{\mu_1}(T)\oplus\cdots\oplus E_{\mu_d}(T)$};
  \node[block] (operator) at (5.59,0) {$T$};

  \draw[arrow] (space) -- (decomp);
  \draw[arrow] (decomp) -- (operator);
\end{tikzpicture}
