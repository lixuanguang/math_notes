\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  subspace/.style={blue!65!black, line width=0.8pt},
  vec/.style={->, blue!75!black, line width=0.95pt},
  proj/.style={->, teal!70!black, line width=0.9pt},
  residual/.style={->, red!70!black, line width=0.85pt},
  candidate/.style={->, gray!65, line width=0.7pt},
  point/.style={circle, fill=black, inner sep=1pt}
]
  \coordinate (O) at (0,0);
  \coordinate (A) at (-0.5,-0.2);
  \coordinate (B) at (4.2,1.25);
  \coordinate (P) at (2.3,0.67);
  \coordinate (V) at (1.7,2.35);
  \coordinate (U) at (3.35,0.99);

  \draw[subspace] (A) -- (B) node[right] {$\mathcal{U}$};
  \draw[vec] (O) -- (V) node[midway, above left] {$\mathbf{v}$};
  \draw[proj] (O) -- (P) node[midway, below right] {$P_{\mathcal{U}}\mathbf{v}$};
  \draw[residual] (P) -- (V) node[midway, right] {$\mathbf{v}-P_{\mathcal{U}}\mathbf{v}$};
  \draw[candidate] (V) -- (U) node[midway, right] {$\mathbf{v}-\mathbf{u}$};
  \draw[gray!60] (2.11,0.61) -- (2.05,0.8) -- (2.24,0.86);

  \node[point, label=below left:{$\mathbf{0}$}] at (O) {};
  \node[point, label=below:{$P_{\mathcal{U}}\mathbf{v}$}] at (P) {};
  \node[point, label=above:{$\mathbf{v}$}] at (V) {};
  \node[point, label=below:{$\mathbf{u}$}] at (U) {};
\end{tikzpicture}
