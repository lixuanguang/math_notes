\begin{tikzpicture}[
  font=\small,
  layer/.style={draw=teal!65, fill=teal!7, rounded corners=2pt, minimum width=2.2cm, minimum height=0.65cm, align=center},
  arrow/.style={-{Stealth[length=2mm]}, thick, teal!70}
]
  \node[layer] (n1) at (0,0) {$\ker(N)$};
  \node[layer] (n2) at (2.8,0) {$\ker(N^2)$};
  \node[layer] (n3) at (5.6,0) {$\ker(N^3)$};
  \node[layer] (dots) at (8.1,0) {$\cdots$};
  \node[layer] (nn) at (10.7,0) {$\ker(N^n)=\mathcal{V}$};

  \draw[arrow] (n1) -- (n2);
  \draw[arrow] (n2) -- (n3);
  \draw[arrow] (n3) -- (dots);
  \draw[arrow] (dots) -- (nn);
\end{tikzpicture}
