\begin{tikzpicture}[
  font=\small,
  subspace/.style={draw=blue!60, fill=blue!6, rounded corners=2pt, minimum height=0.55cm, align=center},
  arrow/.style={-{Stealth[length=2mm]}, thick, blue!65}
]
  \node[subspace, minimum width=1.1cm] (k0) at (0,0) {$\ker(T^0)$};
  \node[subspace, minimum width=1.35cm] (k1) at (1.85,0) {$\ker(T)$};
  \node[subspace, minimum width=1.5cm] (k2) at (3.87,0) {$\ker(T^2)$};
  \node[subspace, minimum width=1.1cm] (dots) at (5.72,0) {$\cdots$};
  \node[subspace, minimum width=1.5cm] (kn) at (7.39,0) {$\ker(T^n)$};
  \node[subspace, minimum width=1.6cm] (kn1) at (10.12,0) {$\ker(T^{n+1})$};
  \node[subspace, minimum width=1.1cm] (tail) at (11.88,0) {$\cdots$};

  \draw[arrow] (k0) -- (k1);
  \draw[arrow] (k1) -- (k2);
  \draw[arrow] (k2) -- (dots);
  \draw[arrow] (dots) -- (kn);
  \draw[arrow] (kn) -- node[above, black] {\scriptsize stabilizes} (kn1);
  \draw[arrow] (kn1) -- (tail);

  \draw[gray!70, thick] (-0.62,-0.63) -- (7.70,-0.63);
  \draw[gray!70, thick] (-0.62,-0.55) -- (-0.62,-0.71);
  \draw[gray!70, thick] (7.70,-0.55) -- (7.70,-0.71);
  \node[below, black] at (3.61,-0.80) {at most $\dim(\mathcal{V})$ strict growth steps};
\end{tikzpicture}
