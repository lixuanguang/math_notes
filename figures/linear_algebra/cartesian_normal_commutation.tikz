\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  box/.style={draw=gray!55, rounded corners=3pt, fill=gray!6, align=center, inner xsep=8pt, inner ysep=6pt, minimum height=1.05cm},
  result/.style={box, fill=green!7, minimum width=4.6cm},
  arrow/.style={->, line width=0.85pt, blue!70!black}
]
  \node[box, minimum width=1.6cm] (T) at (0,0) {$T$};
  \node[box, minimum width=4.2cm] (parts) at (3.35,0)
    {$H=\frac12(T+T^*)$\\[-1pt]
     $K=\frac{1}{2i}(T-T^*)$\\[-1pt]
     $T=H+iK$};
  \node[result] (normal) at (8.35,0)
    {$T\ \text{normal}\quad\Longleftrightarrow\quad HK=KH$};

  \draw[arrow] (T) -- (parts);
  \draw[arrow] (parts) -- (normal);
\end{tikzpicture}
