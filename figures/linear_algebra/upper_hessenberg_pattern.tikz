\begin{tikzpicture}[
  font=\small,
  cell/.style={minimum width=0.55cm, minimum height=0.45cm, inner sep=1pt, outer sep=0pt, anchor=center},
  free/.style={fill=gray!6},
  subdiag/.style={fill=red!16, text=red!70!black},
  forced/.style={fill=blue!12, text=blue!70!black}
]
  \matrix (H) [
    matrix of math nodes,
    nodes={cell},
    left delimiter={[},
    right delimiter={]},
    row sep=0pt,
    column sep=0pt
  ] {
    |[free]| * & |[free]| * & |[free]| * & |[free]| * & |[free]| *\\
    |[subdiag]| * & |[free]| * & |[free]| * & |[free]| * & |[free]| *\\
    |[forced]| 0 & |[subdiag]| * & |[free]| * & |[free]| * & |[free]| *\\
    |[forced]| 0 & |[forced]| 0 & |[subdiag]| * & |[free]| * & |[free]| *\\
    |[forced]| 0 & |[forced]| 0 & |[forced]| 0 & |[subdiag]| * & |[free]| *\\
  };
\end{tikzpicture}
