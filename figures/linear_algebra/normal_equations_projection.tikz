\begin{tikzpicture}[x=0.88cm, y=0.86cm, font=\small, >=Stealth]
  \coordinate (O) at (0,0);
  \coordinate (A) at (5.0,0.4);
  \coordinate (B) at (6.4,2.1);
  \coordinate (C) at (1.4,1.7);
  \coordinate (P) at (3.8,0.95);
  \coordinate (V) at (4.8,3.25);
  \coordinate (Uone) at (2.0,0.35);
  \coordinate (Utwo) at (2.8,1.0);

  \fill[teal!9] (O) -- (A) -- (B) -- (C) -- cycle;
  \draw[teal!60, thick] (O) -- (A) -- (B) -- (C) -- cycle;
  \node[teal!70!black] at (5.75,1.7) {$\mathcal{U}$};

  \draw[->, thick, gray!80] (O) -- (V) node[above] {$\mathbf{v}$};
  \draw[->, thick, blue!70] (O) -- (P) node[below right] {$P_{\mathcal{U}}\mathbf{v}$};
  \draw[->, thick, red!70] (P) -- (V) node[midway, right] {$\mathbf{v}-P_{\mathcal{U}}\mathbf{v}$};
  \draw[dashed, gray!70] (V) -- (P);

  \draw[->, thick, teal!80!black] (O) -- (Uone) node[below] {$\mathbf{u}_1$};
  \draw[->, thick, teal!80!black] (O) -- (Utwo) node[above left] {$\mathbf{u}_2$};
\end{tikzpicture}
