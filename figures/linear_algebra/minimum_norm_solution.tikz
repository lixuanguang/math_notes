\begin{tikzpicture}[font=\small, >=Stealth]
  \coordinate (O) at (0,0);
  \coordinate (S) at (0,2.2);
  \coordinate (V) at (2.5,0.8);
  \coordinate (X) at (2.5,3.0);
  \coordinate (L1) at (-2.0,1.55);
  \coordinate (L2) at (3.5,3.25);

  \fill[gray!12] (-2.0,-0.45) -- (3.7,0.65) -- (5.0,2.05) -- (-0.7,0.95) -- cycle;
  \draw[gray!55, thick] (-2.0,-0.45) -- (3.7,0.65) -- (5.0,2.05) -- (-0.7,0.95) -- cycle;
  \node[gray!70!black] at (4.2,1.65) {$\ker(A)$};

  \draw[->, thick] (O) -- (0,3.45) node[above] {$\operatorname{col}(A^*)$};
  \draw[->, thick, blue!75] (O) -- (S) node[left] {$\mathbf{s}$};
  \draw[->, thick, gray!80] (O) -- (X) node[right] {$\mathbf{x}$};
  \draw[->, thick, red!70] (S) -- (X) node[midway, above] {$\mathbf{v}\in\ker(A)$};
  \draw[dashed, gray!70] (X) -- (V);
  \draw[dashed, gray!70] (V) -- (O);

  \draw[teal!70, thick] (L1) -- (L2);
  \node[teal!70!black] at (2.5,3.5) {$\mathbf{s}+\ker(A)$};
  \fill (O) circle (1.2pt) node[below left] {$\mathbf{0}$};
  \fill[blue!75] (S) circle (1.4pt);
  \fill[gray!80] (X) circle (1.2pt);
\end{tikzpicture}
