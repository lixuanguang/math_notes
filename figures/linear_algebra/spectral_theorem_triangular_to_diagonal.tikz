\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\small},
  block/.style={draw=gray!55, rounded corners=3pt, inner xsep=5pt, inner ysep=4pt, align=center},
  arrow/.style={->, line width=0.8pt, blue!70!black},
  faint/.style={gray!35, line width=0.7pt}
]
  \node[block] (schur) at (0,0)
    {$[T]_{\gamma}$ upper triangular\\$\left[\begin{smallmatrix}
      \lambda_1 & * & *\\
      0 & \lambda_2 & *\\
      0 & 0 & \lambda_3
    \end{smallmatrix}\right]$};
  \node[block] (normal) at (3.87,0)
    {normality\\$\norm{T\mathbf{e}_j}=\norm{T^*\mathbf{e}_j}$};
  \node[block] (diag) at (7.83,0)
    {$[T]_{\gamma}$ diagonal\\$\left[\begin{smallmatrix}
      \lambda_1 & 0 & 0\\
      0 & \lambda_2 & 0\\
      0 & 0 & \lambda_3
    \end{smallmatrix}\right]$};

  \draw[arrow] (schur) -- (normal);
  \draw[arrow] (normal) -- (diag);

  \draw[faint] (-1.1,0.58) -- (-0.53,0.58);
  \draw[faint] (-0.53,0.58) -- (-0.53,-0.18);
\end{tikzpicture}
