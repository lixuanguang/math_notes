\begin{tikzpicture}[
  >=Stealth,
  every node/.style={font=\scriptsize},
  page/.style={draw=blue!55!black, fill=blue!7, rounded corners=2pt, minimum width=0.58cm, minimum height=0.42cm, inner sep=1pt},
  link/.style={-{Stealth[length=1.6mm]}, blue!70!black, line width=0.55pt}
]
  \path[use as bounding box] (-0.35,-0.72) rectangle (1.85,1.02);

  \node[page] (p1) at (0.00,0.62) {$1$};
  \node[page] (p2) at (1.30,0.62) {$2$};
  \node[page] (p4) at (0.00,-0.42) {$4$};
  \node[page] (p3) at (1.30,-0.42) {$3$};

  \draw[link] (p1) to[bend left=12] (p2);
  \draw[link] (p1) to[bend right=18] (p3);
  \draw[link] (p3) to[bend right=18] (p1);
  \draw[link] (p2) to[bend left=12] (p3);
  \draw[link] (p4) -- (p3);
\end{tikzpicture}
