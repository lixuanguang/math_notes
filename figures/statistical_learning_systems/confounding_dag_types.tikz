% Source: attached directed graph screenshots, Figure 20.10; redrawn as TikZ.
\begin{tikzpicture}[
  >=Stealth,
  line cap=round,
  line join=round,
  every node/.style={font=\small},
  v/.style={inner sep=1pt},
  obs/.style={
    draw=blue!60!black,
    fill=blue!6,
    rounded corners=1pt,
    inner xsep=3pt,
    inner ysep=1.5pt
  },
  latent/.style={
    draw=black!65,
    dashed,
    rounded corners=1pt,
    inner xsep=3pt,
    inner ysep=1.5pt
  },
  edge/.style={->, black!78, line width=0.85pt}
]

  \begin{scope}
    \node[v] (xr) at (0,0) {$X$};
    \node[v] (yr) at (2.05,0) {$Y$};
    \node[v] (zr) at (1.02,1.05) {$Z$};
    \draw[edge] (xr) -- (yr);
    \draw[edge] (zr) -- (yr);
  \end{scope}

  \begin{scope}[xshift=3.05cm]
    \node[v] (xo) at (0,0) {$X$};
    \node[v] (yo) at (2.05,0) {$Y$};
    \node[obs] (zo) at (1.02,1.05) {$Z$};
    \draw[edge] (xo) -- (yo);
    \draw[edge] (zo) -- (xo);
    \draw[edge] (zo) -- (yo);
  \end{scope}

  \begin{scope}[xshift=6.10cm]
    \node[v] (xu) at (0,0) {$X$};
    \node[v] (yu) at (2.05,0) {$Y$};
    \node[latent] (zu) at (1.02,1.05) {$Z$};
    \draw[edge] (xu) -- (yu);
    \draw[edge] (zu) -- (xu);
    \draw[edge] (zu) -- (yu);
  \end{scope}
\end{tikzpicture}
